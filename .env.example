# ─────────────────────────────────────────────────────────────
# OPEN SIGNAL AI — API environment (copy to apps/api/.env)
# Only NAMES live here. Real values are generated/entered locally
# and stored in Render's environment settings. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# local = JSON file for development; firestore = production (Stage 2/3)
STORAGE_DRIVER=local
LOCAL_DATA_FILE=.data/local-store.json

# Generate with:  npm run gen:key -w @open-signal/api
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Optional, only during key rotation: "<oldId>:<oldBase64Key>"
# ENCRYPTION_KEY_PREVIOUS=
SESSION_SECRET=

SESSION_TTL_SEC=43200
INIT_DATA_MAX_AGE_SEC=86400

# Required in production
# PUBLIC_API_URL=https://api.example.com
# MINIAPP_URL=https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false

# Firestore (Stage 2/3). Credentials come from GOOGLE_APPLICATION_CREDENTIALS
# or Render secret file — never from this repository.
# FIREBASE_PROJECT_ID=

# Optional, local only: token of a TEST bot for `npm run seed:dev`
# DEV_BOT_TOKEN=
