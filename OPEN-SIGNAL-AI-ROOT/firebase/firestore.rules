rules_version = '2';

// OPEN SIGNAL AI — Firestore security rules.
//
// Architecture decision: browsers NEVER read or write Firestore directly.
// The Mini App and the Admin panel talk only to the backend API, which uses the
// Firebase Admin SDK (Admin SDK bypasses these rules) and enforces:
//   - Telegram initData validation and bot-bound sessions,
//   - tenant isolation by botId (TenantScope),
//   - admin roles and per-bot manager permissions.
//
// Therefore every client request is denied. This removes the whole class of
// "a user edited someone else's document from the browser console" attacks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
