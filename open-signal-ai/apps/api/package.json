{
  "name": "@open-signal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.ts",
    "gen:key": "node scripts/generate-secrets.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@open-signal/i18n": "0.1.0",
    "@open-signal/indicators": "0.1.0",
    "@open-signal/shared": "0.1.0",
    "fastify": "^5.0.0",
    "zod": "^3.25.0"
  }
}
